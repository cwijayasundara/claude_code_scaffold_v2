{
  "hooks": {
    "BeforeTool": [
      {
        "matcher": "write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "bash .gemini/hooks/pre-write-check.sh",
            "name": "pre-write-check",
            "timeout": 10000,
            "description": "Validate write location and remind about spec requirements"
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "matcher": "write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "bash .gemini/hooks/post-write-lint.sh",
            "name": "post-write-lint",
            "timeout": 30000,
            "description": "Run targeted linters after file writes"
          }
        ]
      }
    ]
  },
  "context": {
    "fileName": ["GEMINI.md"]
  }
}
